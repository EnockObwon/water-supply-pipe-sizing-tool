# STAGE 5 — DISTRIBUTION SHEET + SAVE WORKBOOK
# Distribution network sizing + node pressure summary.
# Run AFTER Stage 4. This saves the final .xlsx file.

ws_di = wb.create_sheet("DISTRIBUTION")
ws_di.sheet_view.showGridLines = False
NC_DI = 21   # columns A–U

hdr(ws_di, 1, "DISTRIBUTION NETWORK PIPE SIZING  —  Hazen-Williams Method", 1, NC_DI, sz=13, ht=30)
ws_di.merge_cells(f'A1:{get_column_letter(NC_DI)}1')
ws_di.cell(row=2, column=1).value = (
    "HDPE PE100  |  Auto Pipe OD & Pressure Rating (PN) Selection  |  Uganda WSS DM 2nd Ed.")
ws_di.cell(row=2, column=1).font = FN(sz=10, it=True, c=C_MED)
ws_di.merge_cells(f'A2:{get_column_letter(NC_DI)}2')
ws_di.row_dimensions[2].height = 18; ws_di.row_dimensions[3].height = 8

# SECTION 1: DEMAND CALCULATION 
subhdr(ws_di, 4, "SECTION 1 — DEMAND CALCULATION", 1, 11)
ws_di.merge_cells('A4:K4')
col_hdr_row(ws_di, 5, ["Parameter","Value","Unit","Notes / Formula"], 1, ht=20)

POP_r=DI_R['POP']; DPOP_r=DI_R['DPOP']; PC_r=DI_R['PERCAP']
NRW_r=DI_R['NRW']; PHF_r=DI_R['PHF'];   ADD_r=DI_R['ADD']
ADF_r=DI_R['ADF']; DQ_r=DI_R['DES_Q'];  HGL_r=DI_R['HGL']
RR_r=DI_R['RRES']; S_r=DI_R['S']

demand_fields = [
    (POP_r,  "Present Population",                      None,
     "persons", "Current census / community count"),
    (DPOP_r, "Design Population  (auto-calculated)",
     f"=IFERROR(B{POP_r}*(1+{p('GR')})^{p('PERIOD')},\"\")",
     "persons", "Present pop × (1 + growth rate)^design period"),
    (PC_r,   "Per Capita Demand",                       f"={p('PERCAP')}",
     "L/cap/day","From PARAMETERS — adjust to local survey data"),
    (NRW_r,  "NRW / Loss Factor",                       f"={p('NRW')}",
     "-",       "From PARAMETERS"),
    (PHF_r,  "Peak Hour Factor  (PHF)",                 f"={p('PHF')}",
     "-",       "From PARAMETERS"),
    (ADD_r,  "Gross Average Daily Demand",
     f"=IFERROR(B{DPOP_r}*B{PC_r}*B{NRW_r}/1000,\"\")",
     "m³/day",  "Design pop × per_capita × NRW ÷ 1000"),
    (ADF_r,  "Average Daily Flow",
     f"=IFERROR(B{ADD_r}*1000/(24*3600),\"\")",
     "L/s",     "Gross ADD × 1000 ÷ 86400"),
    (DQ_r,   "DESIGN FLOW — Peak Hour  (use per branch below)",
     f"=IFERROR(B{ADF_r}*B{PHF_r},\"\")",
     "L/s",     "Average daily flow × PHF"),
    (HGL_r,  "HGL at Supply Point  (Reservoir HWL)",   None,
     "m ASL",   "Enter reservoir high water level from TDH_CALC or survey"),
    (RR_r,   "Min. Residual Pressure at Consumer",      f"={p('RDIST')}",
     "m",       "From PARAMETERS — Uganda WSS DM rural standard"),
    (S_r,    "Allowable Head Loss Gradient",            f"={p('SDIST')}",
     "m/km",    "From PARAMETERS — override if needed"),
]
for row_n, lab, dft, unit, note in demand_fields:
    bold = (row_n == DQ_r)
    lbl(ws_di, row_n, 1, lab, bold=bold, ind=1)
    ws_di.cell(row=row_n, column=1).border = BD()
    if dft and dft.startswith('='):
        frm(ws_di, row_n, 2, dft, '0.00', lnk=True)
    else:
        inp(ws_di, row_n, 2, None)
    lbl(ws_di, row_n, 3, unit, sz=9);   ws_di.cell(row=row_n, column=3).border = BD()
    lbl(ws_di, row_n, 4, note, sz=9, wrap=True)
    ws_di.merge_cells(start_row=row_n, start_column=4, end_row=row_n, end_column=11)
    ws_di.cell(row=row_n, column=4).border = BD()
    ws_di.row_dimensions[row_n].height = 18

ws_di.row_dimensions[17].height = 8

# Instructions for branching
inst = ws_di.cell(row=18, column=1, value=(
    "ℹ  BRANCHING GUIDANCE:  "
    "Enter each pipe branch as one row. Set 'HGL Start' (col H) manually:  "
    "• First pipe from reservoir: type  =B14  (reservoir HWL).  "
    "• Continuation (series): type  =S{previous_row}  to link to the preceding pipe's HGL End.  "
    "• Branch from junction: type  =S{junction_row}  to link to the junction node's HGL End.  "
    "Flow Q = flow carried by THAT branch only (not cumulative upstream flow).  "
    "Colour coding shows hydraulic status instantly."))
inst.font = FN(sz=9, it=True, c='595959'); inst.alignment = AL(h='left', w=True)
ws_di.merge_cells(f'A18:{get_column_letter(NC_DI)}18')
ws_di.row_dimensions[18].height = 48

# Status key
subhdr(ws_di, 19, "STATUS KEY:", 1, 4)
for ci, (txt, bg, fg) in enumerate([
    ("✓ OK",           C_OKBG, C_OKFG),
    ("⚠ LOW VELOCITY", C_WRNBG,C_WRNFG),
    ("⚠ HIGH VELOCITY",C_ERRBG,C_ERRFG),
    ("⚠ LOW PRESSURE", C_ERRBG,C_ERRFG),
    ("⚠ SIZE N/A",     C_ERRBG,C_ERRFG),
], start=5):
    c = ws_di.cell(row=19, column=ci, value=txt)
    c.font = FN(bold=True, c=fg, sz=9); c.fill = FL(bg); c.border = BD()
ws_di.row_dimensions[19].height = 18
ws_di.row_dimensions[20].height = 8

# Column headers (20 data cols + Status)
col_hdr_row(ws_di, 21, [
    "#", "From\nNode", "To\nNode", "Length\n(m)", "From Elev\n(m ASL)", "To Elev\n(m ASL)",
    "Flow Q\n(L/s)", "HGL Start\n(m ASL)\n[INPUT]", "Max Working\nPressure (m)",
    "Auto\nPN Num", "Auto\nPN Rating", "Min D_req\n(mm)", "Auto OD\n(mm)", "Actual ID\n(mm)",
    "Velocity\n(m/s)", "Friction\nhf (m)", "Minor\nLoss (m)", "Total\nLoss (m)",
    "HGL End\n(m ASL)", "Pressure\nat End (m)", "Status"
], 1, ht=48)

DI_S = DI_R['SEG_S']; DI_E = DI_R['SEG_E']
DI_HGL_REF = f"$B${HGL_r}"; DI_S_REF = f"$B${S_r}"

for i in range(20):
    r = DI_S + i
    D_c=f"D{r}"; E_c=f"E{r}"; F_c=f"F{r}"; G_c=f"G{r}"
    H_c=f"H{r}"; I_c=f"I{r}"; J_c=f"J{r}"; K_c=f"K{r}"
    L_c=f"L{r}"; M_c=f"M{r}"; N_c=f"N{r}"; O_c=f"O{r}"
    P_c=f"P{r}"; Q_c=f"Q{r}"; R_c=f"R{r}"; S_c=f"S{r}"
    T_c=f"T{r}"

    ws_di.cell(row=r, column=1, value=i+1).alignment = AL()
    ws_di.cell(row=r, column=1).border = BD()
    ws_di.row_dimensions[r].height = 18

    inp(ws_di, r, 2)              # From Node
    inp(ws_di, r, 3)              # To Node
    inp(ws_di, r, 4, fmt='0.0')   # Length (m)
    inp(ws_di, r, 5, fmt='0.00')  # From Elevation
    inp(ws_di, r, 6, fmt='0.00')  # To Elevation
    inp(ws_di, r, 7, fmt='0.00')  # Flow Q per branch

    # Col 8: HGL Start — first row defaults to reservoir HWL; rest are inputs
    # (user types =S{prev_row} for continuation or branch junction reference)
    if i == 0:
        c8 = ws_di.cell(row=r, column=8, value=f"={DI_HGL_REF}")
        c8.font = FN(c=C_LINK); c8.fill = FL(C_INP)
        c8.alignment = AL(); c8.border = BD(); c8.number_format = '0.00'
    else:
        inp(ws_di, r, 8, fmt='0.00')   # User links to junction HGL

    # Col 9: Max working pressure = HGL_start − min(From, To Elev)
    frm(ws_di, r,  9, f'=IF(OR({E_c}="",{H_c}=""),"",IFERROR({H_c}-MIN({E_c},{F_c}),0))', '0.1')
    # Col 10: Auto PN num
    frm(ws_di, r, 10, F_PN_num(I_c))
    # Col 11: PN label
    frm(ws_di, r, 11, F_PN_lbl(J_c))
    # Col 12: Min D_req (uses distribution V_max and distribution allowable S)
    frm(ws_di, r, 12, F_Dreq(G_c, DI_S_REF, 'VMAXD'), '0.1')
    # Col 13: Auto OD
    frm(ws_di, r, 13, F_OD(L_c, J_c, G_c), '0')
    # Col 14: Actual ID
    frm(ws_di, r, 14, F_ID(M_c, J_c), '0.00')
    # Col 15: Velocity
    frm(ws_di, r, 15, F_VEL(G_c, N_c), '0.000')
    # Col 16: Friction loss
    frm(ws_di, r, 16, F_HF(G_c, N_c, D_c), '0.000')
    # Col 17: Minor loss
    frm(ws_di, r, 17, F_ML(f"P{r}"), '0.000')
    # Col 18: Total loss
    frm(ws_di, r, 18, F_TL(f"P{r}", f"Q{r}"), '0.000')
    # Col 19: HGL End
    frm(ws_di, r, 19, F_HGL_E(H_c, f"R{r}"), '0.00', lnk=True)
    # Col 20: Pressure at end node
    frm(ws_di, r, 20, F_PRESS(S_c, F_c), '0.00')
    # Col 21: Status (distribution limits)
    frm(ws_di, r, 21, F_STATUS(O_c, T_c, M_c, 'VMAXD', 'VMIND', 'RDIST'))

# Totals row
DI_TOT = DI_R['TOT']
ws_di.cell(row=DI_TOT, column=1, value="TOTALS").font = FN(bold=True)
ws_di.cell(row=DI_TOT, column=1).fill = FL(C_TOTBG); ws_di.cell(row=DI_TOT, column=1).border = BD()
ws_di.merge_cells(start_row=DI_TOT, start_column=1, end_row=DI_TOT, end_column=3)
for col, L in [(4,'D'),(16,'P'),(17,'Q'),(18,'R')]:
    tot(ws_di, DI_TOT, col, f'=IFERROR(SUM({L}{DI_S}:{L}{DI_E}),0)', '0.000')
for col in range(1, NC_DI+1):
    c = ws_di.cell(row=DI_TOT, column=col)
    if not c.value: c.fill = FL(C_TOTBG); c.border = BD()
ws_di.row_dimensions[DI_TOT].height = 20
ws_di.row_dimensions[DI_TOT+1].height = 8

# SECTION 2: NODE PRESSURE SUMMARY 
NS_r = DI_TOT + 2
subhdr(ws_di, NS_r, "SECTION 2 — NODE PRESSURE CHECK SUMMARY", 1, NC_DI)
ws_di.merge_cells(f'A{NS_r}:{get_column_letter(NC_DI)}{NS_r}')
c_inst = ws_di.cell(row=NS_r+1, column=1, value=(
    "Enter node names and ground elevations. "
    "In 'HGL at Node' column, type the Excel reference to the corresponding HGL End (col S) "
    "from the pipe branch table above — e.g. =S22 for the first branch end node."))
c_inst.font = FN(sz=9, it=True, c='595959'); c_inst.alignment = AL(h='left', w=True)
ws_di.merge_cells(f'A{NS_r+1}:{get_column_letter(NC_DI)}{NS_r+1}')
ws_di.row_dimensions[NS_r+1].height = 30

col_hdr_row(ws_di, NS_r+2,
            ["#","Node Name","Ground Elev\n(m ASL)","HGL at Node\n(m ASL)  [INPUT]",
             "Pressure Head\n(m)","Min Required\n(m)","Status"], 1, ht=30)

for j in range(10):
    r = NS_r + 3 + j
    ws_di.cell(row=r, column=1, value=j+1).alignment = AL()
    ws_di.cell(row=r, column=1).border = BD()
    inp(ws_di, r, 2)              # Node name
    inp(ws_di, r, 3, fmt='0.00') # Ground elevation
    inp(ws_di, r, 4, fmt='0.00') # HGL at node (user references from pipe table col S)
    frm(ws_di, r, 5, f'=IF(OR(C{r}="",D{r}=""),"",D{r}-C{r})', '0.00')
    frm(ws_di, r, 6, f"={p('RDIST')}", '0.0', lnk=True)
    frm(ws_di, r, 7,
        f'=IF(E{r}="","",IF(E{r}>={p("RDIST")},"✓ OK","⚠ LOW PRESSURE"))')
    ws_di.row_dimensions[r].height = 18

ws_di.freeze_panes = 'D1'   # freeze cols A–C (seg#, From/To node) for horizontal scroll
cw(ws_di, {'A':4,'B':14,'C':12,'D':10,'E':12,'F':12,'G':9,'H':14,
            'I':13,'J':9,'K':11,'L':11,'M':11,'N':10,'O':11,
            'P':11,'Q':11,'R':11,'S':12,'T':11,'U':16})

# SHEET TAB COLOURS 
wb["COVER"].sheet_properties.tabColor        = "1F3864"
wb["PARAMETERS"].sheet_properties.tabColor   = "4472C4"
wb["PIPE_DB"].sheet_properties.tabColor      = "595959"
wb["TDH_CALC"].sheet_properties.tabColor     = "2E75B6"
wb["TRANSMISSION"].sheet_properties.tabColor = "375623"
wb["DISTRIBUTION"].sheet_properties.tabColor = "833C00"

# SAVE 
wb.save(OUTPUT_FILE)

print("✅ Stage 5 complete — DISTRIBUTION sheet built.")
print()
print("🎉 ══════════════════════════════════════════════════════")
print(f"   Workbook saved:  {OUTPUT_FILE}")
print("   Sheets: COVER | PARAMETERS | PIPE_DB |")
print("           TDH_CALC | TRANSMISSION | DISTRIBUTION")
print("══════════════════════════════════════════════════════")
print()
print("📥 Google Colab download:")
print("   Files panel (left sidebar) → right-click on file → Download")
print()
print("📌 Workflow:")
print("   1. PARAMETERS — check/adjust defaults")
print("   2. TDH_CALC   — enter well & reservoir data → get TDH & pump power")
print("   3. TRANSMISSION — enter pipe segments → auto OD/PN selected")
print("   4. DISTRIBUTION — enter demand & branch data → node pressures checked")
